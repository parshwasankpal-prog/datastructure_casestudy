# Public Transport Network using Adjacency Matrix

bus_stops = ["Swargate", "Deccan", "Shivajinagar", "Kothrud", "Pune Station"]

n = len(bus_stops)

matrix = [[0 for j in range(n)] for i in range(n)]

routes = [
    (0, 1),
    (0, 4),
    (1, 2),
    (1, 3),
    (2, 4),
    (3, 4)
]

for a, b in routes:
    matrix[a][b] = 1
    matrix[b][a] = 1

print("Public Transport Network - Adjacency Matrix\n")

print("     ", end="")
for stop in bus_stops:
    print(stop[:3], end="  ")
print()

for i in range(n):
    print(bus_stops[i][:3], end="    ")
    for j in range(n):
        print(matrix[i][j], end="    ")
    print()

print("\nDirect Bus Connections:")

for i in range(n):
    for j in range(i + 1, n):
        if matrix[i][j] == 1:
            print(bus_stops[i], "is connected to", bus_stops[j])
