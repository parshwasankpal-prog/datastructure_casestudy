def merge_sort(students):
    if len(students) <= 1:
        return students
    mid = len(students) 
    left = merge_sort(students[:mid])
    right = merge_sort(students[mid:])
    return merge(left, right)

def merge(left, right):
    result = []
    i = 0
    j = 0
    while i < len(left) and j < len(right):
        if left[i][2] <= right[j][2]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1
    result.extend(left[i:])
    result.extend(right[j:])
    return result
n = int(input("Enter number of students: "))
students = []

for i in range(n):
    print(f"\nEnter details of student {i + 1}:")
    roll = int(input("Enter roll number: "))
    name = input("Enter student name: ")
    marks = float(input("Enter marks: "))

    students.append((roll, name, marks))
sorted_students = merge_sort(students)

print("\nSTUDENT MARKS SORTING SYSTEM")
print("-" * 45)
print(f"{'Roll No':<10}{'Name':<20}{'Marks':<10}")
print("-" * 45)

for roll, name, marks in sorted_students:
    print(f"{roll:<10}{name:<20}{marks:<10.2f}")
