# Google Calendar Event Scheduling using Greedy Strategy

events = [
    ("Meeting", 9, 10),
    ("Study", 10, 12),
    ("Lunch", 12, 13),
    ("Workshop", 11, 14),
    ("Seminar", 13, 15),
    ("Project", 14, 16)
]
events.sort(key=lambda x: x[2])

print("Google Calendar Event Scheduling")
print("\nAll Events:")

for event in events:
    print(event[0], "-", str(event[1]) + ":00 to",
          str(event[2]) + ":00")

print("\nSelected Events:")

last_end = 0

for event in events:
    if event[1] >= last_end:
        print(event[0], "-", str(event[1]) + ":00 to",
              str(event[2]) + ":00")
        last_end = event[2]
